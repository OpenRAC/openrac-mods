    "rac1.moby.toxic_crab.update",
    "rac1.moby.psytcopus.update",
    "rac1.moby.moby1246.update",
    "rac1.moby.blarg_space_commando.update",
    "rac1.moby.moby1267.update",
    "rac1.moby.linked_turret.update",
    "rac1.moby.blarg_commander.update",
    "rac1.moby.moby1382.update",
    "rac1.moby.wandering_helper.update",
    "rac1.moby.path_follow_moby.update"
  ],
  "settings": [
    {
      "key": "enemy_count",
      "name": "Enemy count",
      "type": "float",
      "default": 1.0,
      "min": 0.25,
      "max": 4.0,
      "step": 0.25,
      "description": "Above 1: copies of the enemies beside them, as room in the level allows (bosses, waves, turrets and scripted enemies never). Below 1: that share of the free-roaming enemies left out. Counts from the next level loaded."
    },
    {
      "key": "damage_taken",
      "name": "Damage to Ratchet",
      "type": "float",
      "default": 1.0,
      "min": 0.25,
      "max": 4.0,
      "step": 0.25,
      "description": "Cells of health a hit takes, on average: 2 is two cells a hit, 0.5 a cell every other hit."
    },
    {
      "key": "damage_dealt",
      "name": "Damage to enemies",
      "type": "float",
      "default": 1.0,
      "min": 0.25,
      "max": 4.0,
      "step": 0.25,
      "description": "The damage of every hit on an enemy or a boss: your weapons, the wrench, explosions."
    },
    {
      "key": "enemy_speed",
      "name": "Enemy speed",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.05,
      "description": "How fast enemies and turrets move, turn, animate and fire (what their own clocks run on)."
    },
    {
      "key": "player_speed",
      "name": "Ratchet's speed",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 2.0,
      "step": 0.1,
      "description": "Ratchet's walking and running speed."
    },
    {
      "key": "weapon_cost",
      "name": "Weapon prices",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 5.0,
      "step": 0.05,
      "description": "What the Gadgetron vendor and the NPCs ask for weapons and gadgets."
    },
    {
      "key": "ammo_cost",
      "name": "Ammo prices",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 5.0,
      "step": 0.1,
      "description": "The vendor's price for each round of ammo."
    },
    {
      "key": "ammo_use",
      "name": "Ammo per shot",
      "type": "float",
      "default": 1.0,
      "min": 0.25,
      "max": 4.0,
      "step": 0.25,
      "description": "Rounds each shot uses, on average."
    },
    {
      "key": "max_ammo",
      "name": "Max ammo",
      "type": "float",
      "default": 1.0,
      "min": 0.25,
      "max": 4.0,
      "step": 0.25,
      "description": "How much ammo each weapon holds."
    },
    {
      "key": "bolts",
      "name": "Bolt drops",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 5.0,
      "step": 0.25,
      "description": "Bolts from enemies and crates. 0: none."
    },
    {
      "key": "max_health",
      "name": "Max health",
      "type": "float",
      "default": 1.0,
      "min": 0.25,
      "max": 2.0,
      "step": 0.25,
      "description": "Cells of health: the HUD shows 1 to 5 or 8, so the nearest of those at or below (4 cells at 2.0 make 8; with Ultra Nanotech 8 stays the most)."
    },
    {
      "key": "health_pickups",
      "name": "Health pickups",
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 4.0,
      "step": 0.25,
      "description": "Cells each nanotech pickup gives, on average. 0: none."
    },
    {
      "key": "chaos",
      "name": "Chaos",
      "type": "bool",
      "default": false,
      "description": "Each level rolls its own value for every slider left at 1.0, from the seed (the Chaos preset). A slider moved off 1.0 holds on every level."
    },
    {
      "key": "seed",
      "name": "Seed",
      "type": "string",
      "default": "",
      "max_length": 32,
      "description": "For Chaos: the 8-character code from the log plays the same rolls again; any other word too. Blank: a new seed each start, shown in the log."
    },
    {
      "key": "chaos_events",
      "name": "Chaos events",
      "type": "bool",
      "default": false,
      "description": "Every few minutes, a random event for 45 seconds: Turbo Ratchet, slow motion, frenzy, glass cannon, bolt rain, ammo famine, ... (with any preset)."
    },
    {
      "key": "chaos_minutes",
      "name": "Minutes between events",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 30,
      "description": "Of play, with Chaos events on."
    },
    {
      "key": "trace",
      "name": "Trace",
      "type": "bool",
      "default": false,
      "description": "For bug reports: more lines in the game's log (each level's values, max health changes)."
    }
  ],
