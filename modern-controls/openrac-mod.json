{
  "format": 2,
  "id": "modern-controls",
  "name": "Modern Controls",
  "version": "0.2.0",
  "author": "OpenRAC contributors",
  "description": "Direct mouse and controller camera with adjustable turn and aim speed, separate axis sensitivity, radial deadzone, movement speed, and acceleration/braking.",
  "license": "GPL-3.0-or-later",
  "api": "1.9",
  "games": {
    "rac1": [
      "pal",
      "ntsc"
    ]
  },
  "settings": [
    {
      "key": "enabled",
      "name": "Modern controls",
      "type": "bool",
      "default": true
    },
    {
      "key": "mouse_enabled",
      "name": "Mouse / gyro / trackpad camera",
      "type": "bool",
      "default": true
    },
    {
      "key": "mouse_x",
      "name": "Mouse horizontal sensitivity (%)",
      "type": "int",
      "default": 150,
      "min": 10,
      "max": 1000,
      "step": 10
    },
    {
      "key": "mouse_y",
      "name": "Mouse vertical sensitivity (%)",
      "type": "int",
      "default": 150,
      "min": 10,
      "max": 1000,
      "step": 10
    },
    {
      "key": "stick_x",
      "name": "Controller horizontal base speed (degrees / second)",
      "type": "int",
      "default": 240,
      "min": 30,
      "max": 720,
      "step": 10
    },
    {
      "key": "stick_y",
      "name": "Controller vertical base speed (degrees / second)",
      "type": "int",
      "default": 150,
      "min": 30,
      "max": 360,
      "step": 10
    },
    {
      "key": "controller_speed",
      "name": "Controller camera speed (%)",
      "type": "int",
      "default": 100,
      "min": 25,
      "max": 300,
      "step": 25,
      "description": "Scales both right-stick axes. Mouse, gyro and trackpad sensitivity are unchanged."
    },
    {
      "key": "aim_speed",
      "name": "Controller first-person aiming speed (%)",
      "type": "int",
      "default": 75,
      "min": 25,
      "max": 200,
      "step": 25,
      "description": "Additional right-stick multiplier while aiming in first person."
    },
    {
      "key": "deadzone",
      "name": "Right stick deadzone (%)",
      "type": "int",
      "default": 10,
      "min": 0,
      "max": 40,
      "step": 1
    },
    {
      "key": "invert_y",
      "name": "Invert vertical look",
      "type": "bool",
      "default": false
    },
    {
      "key": "response",
      "name": "Movement acceleration and braking (%)",
      "type": "int",
      "default": 175,
      "min": 100,
      "max": 300,
      "step": 25
    },
    {
      "key": "move_speed",
      "name": "Movement speed (%)",
      "type": "int",
      "default": 100,
      "min": 50,
      "max": 200,
      "step": 10,
      "description": "On-foot target speed, independent of camera speed and acceleration. 100% preserves the original run speed."
    }
  ],
  "conflicts": [
    {
      "id": "keyboard-mouse",
      "reason": "Both mods control the mouse camera."
    }
  ]
}
