{
  "format": 2,
  "id": "keyboard-mouse",
  "name": "Keyboard and mouse",
  "version": "1.0.0",
  "author": "OpenRAC contributors",
  "description": "Plays Ratchet & Clank with a keyboard and mouse: WASD moves, the mouse aims the camera, left click fires, holding right click opens the Quick Select and the mouse picks its slot, Space jumps, Escape pauses, the number keys and the wheel change weapons. Every action can be bound to any key, mouse button or wheel direction, two binds each, with Left-handed and Arrow keys presets. A gamepad keeps working beside it.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/OpenRAC/rac1-mods/tree/master/keyboard-mouse",
  "api": "1.2",
  "games": {
    "rac1": [
      "pal",
      "ntsc"
    ]
  },
  "hooks": [
    "rac1.camera.follow.apply_overrides"
  ],
  "settings": [
    {
      "key": "mouse_sensitivity",
      "name": "Mouse sensitivity",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 10.0,
      "step": 0.1,
      "description": "How far the camera turns for the mouse's motion."
    },
    {
      "key": "mouse_acceleration",
      "name": "Mouse acceleration",
      "type": "float",
      "default": 0.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.1,
      "description": "0 for none; more turns a fast flick further than a slow drag."
    },
    {
      "key": "invert_y",
      "name": "Invert the mouse's up and down",
      "type": "bool",
      "default": false
    },
    {
      "key": "camera_tilt",
      "name": "Camera tilt",
      "type": "choice",
      "default": "hold",
      "choices": [
        {
          "value": "hold",
          "name": "Stays"
        },
        {
          "value": "return",
          "name": "Levels out"
        }
      ],
      "description": "Whether the camera keeps the tilt the mouse gives it, or levels out when the mouse rests."
    },
    {
      "key": "capture_cursor",
      "name": "Capture the cursor in play",
      "type": "bool",
      "default": true,
      "description": "Hides the cursor and keeps it in the window while you play; menus and pausing let it go."
    },
    {
      "key": "walk_speed",
      "name": "Walk speed",
      "type": "float",
      "default": 0.5,
      "min": 0.2,
      "max": 0.9,
      "step": 0.05,
      "description": "How far the walk key pushes the stick."
    },
    {
      "key": "stick_ramp_ms",
      "name": "Stick ramp (ms)",
      "type": "int",
      "default": 60,
      "min": 0,
      "max": 300,
      "description": "How long the movement keys take to push the stick all the way: a tap nudges, a hold runs."
    },
    {
      "key": "quick_select_dead_zone",
      "name": "Quick Select dead zone",
      "type": "int",
      "default": 30,
      "min": 5,
      "max": 200,
      "description": "How far, in pixels, the mouse moves before the Quick Select points at a slot."
    },
    {
      "key": "move_forward",
      "name": "Move forward",
      "type": "keybind",
      "default": "KeyW",
      "group": "play",
      "description": "Pushes the left stick forward."
    },
    {
      "key": "move_back",
      "name": "Move back",
      "type": "keybind",
      "default": "KeyS",
      "group": "play"
    },
    {
      "key": "move_left",
      "name": "Move left",
      "type": "keybind",
      "default": "KeyA",
      "group": "play"
    },
    {
      "key": "move_right",
      "name": "Move right",
      "type": "keybind",
      "default": "KeyD",
      "group": "play"
    },
    {
      "key": "walk",
      "name": "Walk (hold)",
      "type": "keybind",
      "default": "AltLeft",
      "group": "play",
      "description": "Moves at the walk speed below while held."
    },
    {
      "key": "jump",
      "name": "Jump",
      "type": "keybind",
      "default": "Space",
      "group": "play",
      "description": "Cross."
    },
    {
      "key": "fire",
      "name": "Fire",
      "type": "keybind",
      "default": "MouseLeft",
      "group": "play",
      "description": "Circle: fires the weapon or gadget in hand."
    },
    {
      "key": "quick_select",
      "name": "Quick Select (hold)",
      "type": "keybind",
      "default": "MouseRight",
      "group": "play",
      "description": "Triangle, held: move the mouse toward a slot and let go to take it."
    },
    {
      "key": "wrench",
      "name": "Wrench",
      "type": "keybind",
      "default": "KeyF,MouseMiddle",
      "group": "play",
      "description": "Square."
    },
    {
      "key": "crouch",
      "name": "Crouch",
      "type": "keybind",
      "default": "ControlLeft,KeyC",
      "group": "play",
      "description": "R1."
    },
    {
      "key": "strafe",
      "name": "Strafe",
      "type": "keybind",
      "default": "ShiftLeft",
      "group": "play",
      "description": "L2 (the lock-strafe mod's Hold mode strafes with it)."
    },
    {
      "key": "first_person",
      "name": "First-person view",
      "type": "keybind",
      "default": "KeyV,MouseBack",
      "group": "play",
      "description": "L1, held."
    },
    {
      "key": "map",
      "name": "Map",
      "type": "keybind",
      "default": "Tab,KeyM",
      "group": "play",
      "description": "Select."
    },
    {
      "key": "camera_reset",
      "name": "Camera behind Ratchet",
      "type": "keybind",
      "default": "KeyQ",
      "group": "play",
      "description": "Swings the camera round behind him and levels it."
    },
    {
      "key": "pause",
      "name": "Pause",
      "type": "keybind",
      "default": "Escape,KeyP",
      "group": "play",
      "description": "Start: the pause menu."
    },
    {
      "key": "weapon_1",
      "name": "Quick Select slot 1",
      "type": "keybind",
      "default": "Digit1",
      "group": "play",
      "description": "Takes the item in that slot of the Quick Select at once (slot 1 is the top, then clockwise)."
    },
    {
      "key": "weapon_2",
      "name": "Quick Select slot 2",
      "type": "keybind",
      "default": "Digit2",
      "group": "play"
    },
    {
      "key": "weapon_3",
      "name": "Quick Select slot 3",
      "type": "keybind",
      "default": "Digit3",
      "group": "play"
    },
    {
      "key": "weapon_4",
      "name": "Quick Select slot 4",
      "type": "keybind",
      "default": "Digit4",
      "group": "play"
    },
    {
      "key": "weapon_5",
      "name": "Quick Select slot 5",
      "type": "keybind",
      "default": "Digit5",
      "group": "play"
    },
    {
      "key": "weapon_6",
      "name": "Quick Select slot 6",
      "type": "keybind",
      "default": "Digit6",
      "group": "play"
    },
    {
      "key": "weapon_7",
      "name": "Quick Select slot 7",
      "type": "keybind",
      "default": "Digit7",
      "group": "play"
    },
    {
      "key": "weapon_8",
      "name": "Quick Select slot 8",
      "type": "keybind",
      "default": "Digit8",
      "group": "play"
    },
    {
      "key": "weapon_next",
      "name": "Next weapon",
      "type": "keybind",
      "default": "WheelDown",
      "group": "play",
      "description": "The next Quick Select slot that holds something."
    },
    {
      "key": "weapon_prev",
      "name": "Previous weapon",
      "type": "keybind",
      "default": "WheelUp",
      "group": "play"
    },
    {
      "key": "menu_confirm",
      "name": "Menu: confirm",
      "type": "keybind",
      "default": "Enter,NumpadEnter",
      "group": "menu",
      "description": "Cross, in menus."
    },
    {
      "key": "menu_back",
      "name": "Menu: back",
      "type": "keybind",
      "default": "Backspace",
      "group": "menu",
      "description": "Triangle, in menus."
    },
    {
      "key": "menu_up",
      "name": "Menu: up",
      "type": "keybind",
      "default": "ArrowUp",
      "group": "menu",
      "description": "The d-pad, in menus."
    },
    {
      "key": "menu_down",
      "name": "Menu: down",
      "type": "keybind",
      "default": "ArrowDown",
      "group": "menu"
    },
    {
      "key": "menu_left",
      "name": "Menu: left",
      "type": "keybind",
      "default": "ArrowLeft",
      "group": "menu"
    },
    {
      "key": "menu_right",
      "name": "Menu: right",
      "type": "keybind",
      "default": "ArrowRight",
      "group": "menu"
    }
  ],
  "presets": [
    {
      "id": "left_handed",
      "name": "Left-handed",
      "values": {
        "move_forward": "KeyI",
        "move_back": "KeyK",
        "move_left": "KeyJ",
        "move_right": "KeyL",
        "walk": "AltRight",
        "wrench": "KeyH,MouseMiddle",
        "crouch": "ControlRight,KeyN",
        "strafe": "ShiftRight",
        "first_person": "KeyU,MouseBack",
        "map": "KeyM,Backslash",
        "camera_reset": "KeyO",
        "pause": "Escape,KeyP"
      }
    },
    {
      "id": "arrows",
      "name": "Arrow keys",
      "values": {
        "move_forward": "ArrowUp",
        "move_back": "ArrowDown",
        "move_left": "ArrowLeft",
        "move_right": "ArrowRight",
        "walk": "AltRight",
        "crouch": "ControlRight,KeyC",
        "strafe": "ShiftRight",
        "menu_up": "",
        "menu_down": "",
        "menu_left": "",
        "menu_right": ""
      }
    }
  ]
}
